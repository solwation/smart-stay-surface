#!/usr/bin/env python3
"""
smart-stay: Keep screen awake while on AC power and presence is detected.

Uses the front-facing camera (via libcamera) with two detection modes:
  - Face detection (default): dlib HOG with histogram equalization
  - Motion detection (--motion): frame-to-frame difference, works with any angle

Inhibits GNOME idle/screensaver via DBus when presence is detected.
Only runs checks while on external power (AC adapter).

Usage:
    smart-stay              # run in foreground (face mode)
    smart-stay --motion     # run in foreground (motion mode)
    smart-stay --daemon     # run as background daemon
    smart-stay --stop       # stop running daemon
    smart-stay --status     # check if running
"""

import argparse
import libcamera
import numpy as np
import dlib
import dbus
import mmap
import os
import signal
import sys
import time
from PIL import Image

PIDFILE = os.path.expanduser("~/.cache/smart-stay.pid")
CHECK_INTERVAL = 30        # seconds between face checks
GRACE_CHECKS = 2           # keep inhibiting for N checks after face disappears
AC_POWER_PATH = "/sys/class/power_supply/ADP1/online"
CAMERA_INDEX = 1           # front camera
CAPTURE_WIDTH = 1280       # IPU3 ImgU needs >= 1280x720 to produce non-black frames
CAPTURE_HEIGHT = 720
WARMUP_FRAMES = 20         # discard initial frames while IPU3 auto-exposure converges
MOTION_THRESHOLD = 5.0     # mean pixel difference to count as motion (0-255 scale)


def is_on_ac_power():
    try:
        with open(AC_POWER_PATH) as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def capture_frame():
    """Capture a grayscale frame from the front camera. Returns numpy array or None.

    Captures at 1280x720 — the IPU3 ImgU produces black frames at lower resolutions.
    Retries camera acquisition up to 3 times (IPU3 needs time between release/acquire).
    """
    cm = libcamera.CameraManager.singleton()
    if CAMERA_INDEX >= len(cm.cameras):
        return None

    cam = cm.cameras[CAMERA_INDEX]
    # IPU3 needs a moment between release/acquire cycles
    for attempt in range(3):
        try:
            cam.acquire()
            break
        except RuntimeError:
            if attempt == 2:
                return None
            time.sleep(1.0)
    try:
        config = cam.generate_configuration([libcamera.StreamRole.Viewfinder])
        sc = config.at(0)
        sc.size = libcamera.Size(CAPTURE_WIDTH, CAPTURE_HEIGHT)
        config.validate()
        cam.configure(config)

        w, h = sc.size.width, sc.size.height
        frame_size = sc.frame_size
        stream = sc.stream
        allocator = libcamera.FrameBufferAllocator(cam)
        allocator.allocate(stream)
        buffers = allocator.buffers(stream)

        # Pre-queue all buffers to keep the pipeline fed
        cam.start()
        for buf in buffers:
            req = cam.create_request()
            req.add_buffer(stream, buf)
            cam.queue_request(req)

        # Stream for WARMUP_FRAMES to let auto-exposure converge, keep the last
        gray = None
        deadline = time.monotonic() + 5.0  # 5s absolute timeout
        frames_received = 0

        while frames_received < WARMUP_FRAMES + 1:
            if time.monotonic() > deadline:
                break
            # Poll for completed requests
            reqs = cm.get_ready_requests()
            if not reqs:
                time.sleep(0.005)
                continue
            for req in reqs:
                if req.status == libcamera.Request.Status.Complete:
                    buf = req.buffers[stream]
                    fd = buf.planes[0].fd
                    # Must mmap full frame (Y+UV) for IPU3 DMA coherency
                    with mmap.mmap(fd, frame_size, mmap.MAP_SHARED, mmap.PROT_READ) as mm:
                        gray = np.frombuffer(mm[:w * h], dtype=np.uint8).reshape(h, w).copy()
                    frames_received += 1
                    # Re-queue the buffer to keep streaming
                    req2 = cam.create_request()
                    req2.add_buffer(stream, buf)
                    cam.queue_request(req2)

        cam.stop()
    finally:
        cam.release()

    return gray


def detect_faces(gray):
    """Run dlib face detection on a grayscale frame. Returns list of face rects.

    Applies histogram equalization first to handle uneven lighting/backlighting,
    and uses upsample=1 for better detection of smaller or distant faces.
    """
    # Equalize contrast — helps with backlighting and low-light conditions
    equalized = equalize_histogram(gray)
    detector = dlib.get_frontal_face_detector()
    return detector(equalized, 1)


def equalize_histogram(gray):
    """CLAHE-style histogram equalization using numpy (no OpenCV dependency)."""
    hist, _ = np.histogram(gray.flatten(), bins=256, range=(0, 256))
    cdf = hist.cumsum()
    # Mask zero bins
    cdf_min = cdf[cdf > 0].min()
    total = gray.size
    lut = ((cdf - cdf_min) * 255 / (total - cdf_min)).clip(0, 255).astype(np.uint8)
    return lut[gray]


def detect_motion(gray, prev_frame):
    """Compare current frame to previous frame. Returns (has_motion, diff_value)."""
    if prev_frame is None:
        return True, 0.0  # first frame — assume someone is there
    # Downscale both to 320x240 for fast comparison and noise reduction
    cur = Image.fromarray(gray, mode="L").resize((320, 240), Image.BILINEAR)
    prev = Image.fromarray(prev_frame, mode="L").resize((320, 240), Image.BILINEAR)
    diff = np.abs(np.array(cur, dtype=np.float32) - np.array(prev, dtype=np.float32))
    mean_diff = diff.mean()
    return mean_diff > MOTION_THRESHOLD, mean_diff


def check_for_face():
    """Capture a frame from the front camera and check for faces."""
    gray = capture_frame()
    if gray is None:
        return False
    return len(detect_faces(gray)) > 0


class IdleInhibitor:
    def __init__(self):
        self._cookie = None
        self._bus = dbus.SessionBus()
        obj = self._bus.get_object(
            "org.gnome.SessionManager", "/org/gnome/SessionManager"
        )
        self._iface = dbus.Interface(obj, "org.gnome.SessionManager")

    def inhibit(self):
        if self._cookie is None:
            self._cookie = self._iface.Inhibit(
                "smart-stay",
                dbus.UInt32(0),
                "Face detected on front camera",
                dbus.UInt32(8),  # inhibit idle
            )

    def uninhibit(self):
        if self._cookie is not None:
            try:
                self._iface.Uninhibit(self._cookie)
            except dbus.exceptions.DBusException:
                pass
            self._cookie = None

    @property
    def active(self):
        return self._cookie is not None


def log(msg):
    print(f"[smart-stay] {msg}", flush=True)


def run_loop(use_motion=False):
    inhibitor = IdleInhibitor()
    grace_remaining = 0
    prev_frame = None
    mode_name = "motion" if use_motion else "face"

    def cleanup(signum=None, frame=None):
        inhibitor.uninhibit()
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        log("Stopped.")
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    # Write PID file
    os.makedirs(os.path.dirname(PIDFILE), exist_ok=True)
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))

    log(f"Started (pid {os.getpid()}), mode={mode_name}, checking every {CHECK_INTERVAL}s")

    while True:
        try:
            if not is_on_ac_power():
                if inhibitor.active:
                    log("Switched to battery — releasing inhibitor")
                    inhibitor.uninhibit()
                    grace_remaining = 0
                    prev_frame = None
                else:
                    log("On battery — skipping check")
                time.sleep(CHECK_INTERVAL)
                continue

            gray = capture_frame()
            if use_motion:
                if gray is not None:
                    present, diff = detect_motion(gray, prev_frame)
                    prev_frame = gray
                else:
                    present, diff = False, 0.0
            else:
                present = gray is not None and len(detect_faces(gray)) > 0

            if present:
                grace_remaining = GRACE_CHECKS
                if use_motion:
                    detail = f"diff={diff:.1f}" if diff > 0 else "first frame"
                    log_msg = f"Motion detected ({detail}) — "
                else:
                    log_msg = "Face detected — "
                if not inhibitor.active:
                    log(log_msg + "inhibiting idle")
                else:
                    log(log_msg + "inhibitor still active")
                inhibitor.inhibit()
            else:
                if grace_remaining > 0:
                    grace_remaining -= 1
                    if use_motion:
                        log(f"No motion (diff={diff:.1f}) — grace ({grace_remaining} remaining)")
                    else:
                        log(f"No face — grace period ({grace_remaining} checks remaining)")
                else:
                    if inhibitor.active:
                        log(f"No {mode_name} detected — releasing inhibitor")
                    else:
                        log(f"No {mode_name} detected — idle allowed")
                    inhibitor.uninhibit()

        except Exception as e:
            log(f"Error: {e}")
            inhibitor.uninhibit()

        time.sleep(CHECK_INTERVAL)


def debug_capture(use_motion=False):
    """Capture frames every 5s for 30s, saving images with detection results."""
    from PIL import ImageDraw
    out_dir = "/tmp/smart-stay-debug"
    os.makedirs(out_dir, exist_ok=True)

    mode_name = "motion" if use_motion else "face"
    print(f"Debug capture ({mode_name} mode): 7 frames over 30s, saving to {out_dir}/")
    print("Look at the camera, then move away partway through.\n")

    prev_frame = None
    for i in range(7):
        ts = time.strftime("%H:%M:%S")
        gray = capture_frame()
        if gray is None:
            print(f"  [{ts}] Frame {i}: FAILED to capture")
            time.sleep(5)
            continue

        # Detection
        faces = detect_faces(gray) if not use_motion else []
        has_motion, diff = detect_motion(gray, prev_frame)
        prev_frame = gray

        # Save image
        img = Image.fromarray(gray, mode="L")
        if faces:
            img = img.convert("RGB")
            draw = ImageDraw.Draw(img)
            for face in faces:
                draw.rectangle(
                    [face.left(), face.top(), face.right(), face.bottom()],
                    outline="green", width=2,
                )

        path = os.path.join(out_dir, f"frame_{i:02d}.png")
        img.save(path)

        parts = []
        if not use_motion:
            parts.append(f"{len(faces)} face(s)" if faces else "no face")
        motion_str = f"motion={diff:.1f}" if diff > 0 else "first"
        if has_motion:
            parts.append(f"MOTION ({motion_str})")
        else:
            parts.append(f"still ({motion_str})")
        print(f"  [{ts}] Frame {i}: {', '.join(parts)} — saved {path}")

        if i < 6:
            time.sleep(5)

    print(f"\nDone. Check images in {out_dir}/")
    print(f"Motion threshold: {MOTION_THRESHOLD} (current setting)")


def get_running_pid():
    try:
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)  # check if alive
        return pid
    except (OSError, ValueError):
        return None


def main():
    parser = argparse.ArgumentParser(description="Keep screen on while face is visible")
    parser.add_argument("--daemon", action="store_true", help="Run in background")
    parser.add_argument("--stop", action="store_true", help="Stop running daemon")
    parser.add_argument("--status", action="store_true", help="Check if running")
    parser.add_argument("--motion", action="store_true",
                        help="Use motion detection instead of face detection (better for profile/side angles)")
    parser.add_argument("--debug-capture", action="store_true",
                        help="Capture frames every 5s for 30s, save to /tmp/smart-stay-debug/")
    args = parser.parse_args()

    if args.stop:
        pid = get_running_pid()
        if pid:
            os.kill(pid, signal.SIGTERM)
            print(f"Stopped smart-stay (pid {pid})")
        else:
            print("smart-stay is not running")
        return

    if args.status:
        pid = get_running_pid()
        if pid:
            print(f"smart-stay is running (pid {pid})")
        else:
            print("smart-stay is not running")
        return

    if args.debug_capture:
        debug_capture(use_motion=args.motion)
        return

    existing = get_running_pid()
    if existing:
        print(f"smart-stay already running (pid {existing}). Use --stop first.")
        sys.exit(1)

    if args.daemon:
        pid = os.fork()
        if pid > 0:
            print(f"smart-stay started in background (pid {pid})")
            sys.exit(0)
        # Child: detach
        os.setsid()
        # Redirect stdout/stderr to log file
        log_path = os.path.expanduser("~/.cache/smart-stay.log")
        log_fd = open(log_path, "a")
        os.dup2(log_fd.fileno(), sys.stdout.fileno())
        os.dup2(log_fd.fileno(), sys.stderr.fileno())

    run_loop(use_motion=args.motion)


if __name__ == "__main__":
    main()
