[Unit]
Description=Smart Stay - keep screen on while face is visible
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/bin/smart-stay
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.cache/smart-stay.log
StandardError=append:%h/.cache/smart-stay.log

[Install]
WantedBy=graphical-session.target
